<Window x:Class="WinClient2.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinClient2"
        Width="{x:Static SystemParameters.VirtualScreenWidth}"
        Height="{x:Static SystemParameters.VirtualScreenHeight}"
        Left="0" Top="0"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Focusable="True"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnWindowLoaded">
    <Grid Background="Transparent">
        <!-- 缩放宿主：整体 LayoutTransform 缩放（顶对齐保持顶栏贴顶、水平居中），
             布局坐标始终用基准值。所有窗口（页面窗口/分类窗口）由代码动态加入此画布 -->
        <Canvas x:Name="ScaleHost"
                Width="{x:Static SystemParameters.VirtualScreenWidth}"
                Height="{x:Static SystemParameters.VirtualScreenHeight}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

            <!-- 顶栏（Top Bar）：还原 Meteor——固定贴顶、屏幕顶部居中、不可拖动 -->
            <Border x:Name="TopBarHost" Background="Transparent" Canvas.Left="0" Canvas.Top="0">
                <StackPanel x:Name="TabHost" Orientation="Horizontal" Background="Transparent" />
            </Border>

        </Canvas>
    </Grid>
</Window>
