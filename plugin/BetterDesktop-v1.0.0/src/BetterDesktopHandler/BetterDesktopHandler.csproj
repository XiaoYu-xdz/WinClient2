<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 目标框架：.NET Framework 4.8（不能用 .NET Core/5+） -->
    <TargetFramework>net48</TargetFramework>
    
    <!-- 输出类型：类库（DLL） -->
    <OutputType>Library</OutputType>
    
    <!-- 平台：x64（Windows 11 64位） -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    
    <!-- 程序集名称 -->
    <AssemblyName>BetterDesktopHandler</AssemblyName>
    <RootNamespace>BetterDesktop</RootNamespace>
    
    <!-- 生成的 DLL 路径 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Platform)\$(Configuration)</OutputPath>
    
    <!-- 禁止 SDK 自动生成 AssemblyInfo（与手动 AssemblyInfo.cs 冲突） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 不再需要 SharpShell，直接实现 IQueryInfo COM 接口 -->
  </ItemGroup>

  <ItemGroup>
    <!-- 显式引用 Windows Forms，用于 Cursor.Position 和 Control.ModifierKeys -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- 用于 DataContractJsonSerializer (JSON 序列化) -->
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>